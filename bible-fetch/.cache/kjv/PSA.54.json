A.54.9"]}},{"name":"char","type":"tag","attrs":{"style":"add"},"items":[{"text":"his desire","type":"text","attrs":{"verseId":"PSA.54.7","verseOrgIds":["PSA.54.9"]}}]},{"text":" upon mine enemies.","type":"text","attrs":{"verseId":"PSA.54.7","verseOrgIds":["PSA.54.9"]}}]}],"next":{"id":"PSA.55","number":"55","bookId":"PSA"},"previous":{"id":"PSA.53","number":"53","bookId":"PSA"}},"meta":{"fumsToken":"GzQBIBwHbqxlyoOgvZ5Jcyp_-iGfx9ZNzqHaVCEdU7J09YXO2wYux92KS3A8EXR2e-3e6swaN2gEtjFKIiYxvXDb_vG8HQD7chacy7vtJYjjZsgDlyFWlSZn9Tzd7WQ-MjEA5nswkYLkhT_WrMY9EA5wbpKMAddvgImTpqKZF8R1KHUshjItAdu7Nu15EyAyd1L0BVsZRvCpQDsiKwzP4_2r50yp50ROS2mCDj2JrlIWXfokTeBYUxIG"}}